[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/streaming/enabled=true
textures/streaming/min_lod=3
textures/streaming/max_lod=7
rendering_device/driver.windows="d3d12"
lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/multi_bounce_occlusion/enabled=true
anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
